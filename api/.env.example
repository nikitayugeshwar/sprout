# Copy to .env for local development. Every value below has a working default
# except in production, where MONGODB_URI and JWT_SECRET are mandatory.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Leave blank locally and an in-memory MongoDB starts automatically.
# In production, point this at MongoDB Atlas.
MONGODB_URI=

# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=sprout-dev-secret-change-me-in-production
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins, or * to allow any.
CORS_ORIGIN=http://localhost:3000

# Stable demo login created by `npm run seed`.
DEMO_EMAIL=demo@sprout.health
DEMO_PASSWORD=sproutdemo
